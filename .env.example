# OpenAI ToDo App Environment Variables

# Public URL Configuration (REQUIRED for ChatGPT widget functionality)
# When using ngrok, set this to your ngrok HTTPS URL
# Example: PUBLIC_URL=https://abc123.ngrok-free.app
# For local testing only: PUBLIC_URL=http://localhost:8000
PUBLIC_URL=http://localhost:8000

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Ngrok Configuration (optional)
# Get your auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_token_here

# Development Mode
DEBUG=true
